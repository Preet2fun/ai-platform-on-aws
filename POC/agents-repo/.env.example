# ─── AWS / region ─────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_PROFILE=agentcore
AWS_ACCOUNT_ID=001961766007

# ─── Bedrock model (shared default; override per agent if needed) ──
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_TEMPERATURE=0.2
BEDROCK_MAX_TOKENS=4096

# ─── AgentCore Memory (set per runtime; values below are the deployed ids) ──
# Supervisor
BEDROCK_AGENTCORE_MEMORY_ID=dev_msp_supervisor_agent_mem-C2TMffDFAR
BEDROCK_AGENTCORE_MEMORY_NAME=dev_msp_supervisor_agent_mem

# ─── AgentCore Gateway (MCP tool aggregation) ─────────────────
AGENTCORE_GATEWAY_URL=https://dev-msp-assistant-gateway-yamkzgvv48.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp

# ─── Cognito (MCP runtime JWT auth) ───────────────────────────
COGNITO_USER_POOL_ID=us-east-1_vyWBkPHjd
COGNITO_M2M_CLIENT_ID=2t0feausc9empnuqq6lgns29bu
COGNITO_SCOPE=mcp-server/invoke
COGNITO_TOKEN_URL=

# ─── Credential providers (AgentCore Identity token vault) ────
JIRA_API_KEY_PROVIDER=dev-jira-api-key
GATEWAY_OAUTH2_PROVIDER=dev-msp-gateway-cognito

# ─── A2A specialist runtime ARNs (supervisor routes to these) ──
# Fill from: aws bedrock-agentcore-control list-agent-runtimes
A2A_SECURITY_ARN=
A2A_COST_ARN=
A2A_CLOUDWATCH_ARN=
A2A_JIRA_ARN=
A2A_KNOWLEDGE_ARN=
A2A_INVESTIGATOR_ARN=
A2A_ADVISOR_ARN=

# ─── Observability ────────────────────────────────────────────
OTEL_ENABLED=true
LOG_LEVEL=INFO
