classDef sec fill:#fce4ec,stroke:#e5397d,color:#880e4f;
classDef edge fill:#e0f7fa,stroke:#00acc1,color:#006064;

class A1,A3,A4 s3;
class SF,E1,E2,E3,E4,E5,QL,P1,P2,P3,P4,P5,P6,A2 compute;
